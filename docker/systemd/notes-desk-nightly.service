# The notes desk's nightly run (docker/systemd/nightly.sh), started by
# notes-desk-nightly.timer. See README.md, "Scheduling" > "Fedora and other
# Linux (systemd timer)".
[Unit]
Description=Notes desk nightly run (fetch closes, value the notes, write the reports)

[Service]
Type=oneshot
# The project folder; change this if yours is somewhere else.
WorkingDirectory=%h/Downloads/notes_desk
# Start the app if needed, run every missed night, push new price files in
# feeds/ (only those) to GitHub, and show a desktop notification with the result.
ExecStart=/bin/sh %h/Downloads/notes_desk/docker/systemd/nightly.sh
# To keep new price files on this computer instead of pushing them, remove the #:
#Environment=NOTES_DESK_PUSH=0
